<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>apps - hannesnagel</title>
    <link rel="stylesheet" href="/css/neon.css">
</head>

<body>
    <div id="site-nav"></div>

    <main class="page">
        <section>
            <div class="apps-head reveal">
                <p class="sub-header">Apps</p>
                <h1>The <em>stuff</em>.</h1>
            </div>
            <div class="apps-grid reveal">
                <article class="app-card">
                    <div class="app-media pod-art" aria-hidden="true">
                        <div class="pod-eq">
                            <i style="--h:55%;--dl:0s"></i><i style="--h:85%;--dl:-.2s"></i><i style="--h:65%;--dl:-.5s"></i><i style="--h:100%;--dl:-.3s"></i><i style="--h:75%;--dl:-.7s"></i><i style="--h:90%;--dl:-.1s"></i><i style="--h:60%;--dl:-.4s"></i>
                        </div>
                    </div>
                    <div class="app-body">
                        <span class="wip-chip">● In development</span>
                        <h2><a class="card-link" href="/podcatcher/">The Podcatcher</a></h2>
                        <p>A podcast app that actually respects your time: iCloud sync everywhere, up to 5× speed, transcripts, automatic chapters, skip rules.</p>
                        <div class="badge-list">
                            <a href="/podcatcher/" class="chip-link">Open details</a>
                            <a href="/contact" class="chip-link">Get notified</a>
                        </div>
                    </div>
                </article>

                <article class="app-card">
                    <div class="app-media light">
                        <img src="/images/i-told-you-so_receipt.png?v=2" alt="I Told You So">
                    </div>
                    <div class="app-body">
                        <h2><a class="card-link" href="/i-told-you-so/">I Told You So</a></h2>
                        <p>Record predictions and friendly bets, settle them later, and share a clean receipt.</p>
                        <div class="badge-list">
                            <a href="https://apps.apple.com/app/id6763559466">
                                <img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83" alt="Download on the App Store" class="app-store-badge">
                            </a>
                            <a href="/i-told-you-so/" class="chip-link">Open details</a>
                            <a href="/i-told-you-so/privacy" class="chip-link">Privacy</a>
                        </div>
                    </div>
                </article>

                <article class="app-card">
                    <div class="app-media">
                        <img src="/images/containeye_promo.png" alt="ContainEye">
                    </div>
                    <div class="app-body">
                        <h2><a class="card-link" href="/containeye/">ContainEye</a></h2>
                        <p>Monitor servers and Docker containers from iPhone. Includes SSH terminal, checks, and shortcuts support.</p>
                        <div class="badge-list">
                            <a href="https://apps.apple.com/us/app/containeye-terminal-docker/id6741063706">
                                <img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83" alt="Download on the App Store" class="app-store-badge">
                            </a>
                            <a href="/containeye/" class="chip-link">Open details</a>
                        </div>
                    </div>
                </article>

                <article class="app-card">
                    <div class="app-media">
                        <img src="/images/recipes_promo.png" alt="Recipes">
                    </div>
                    <div class="app-body">
                        <h2><a class="card-link" href="/recipes/">The Recipes App</a></h2>
                        <p>Recipe collection with shopping list support and web access.</p>
                        <div class="badge-list">
                            <a href="https://apps.apple.com/de/app/the-recipes-app/id6745904570">
                                <img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83" alt="Download on the App Store" class="app-store-badge">
                            </a>
                            <a href="https://recipes.hannesnagel.com" class="chip-link">Web app</a>
                            <a href="/recipes/" class="chip-link">Open details</a>
                        </div>
                    </div>
                </article>

                <article class="app-card">
                    <div class="app-media">
                        <img src="/images/superghost_promo.png" alt="Superghost">
                    </div>
                    <div class="app-body">
                        <h2><a class="card-link" href="/ghost/">Ghost / Superghost</a></h2>
                        <p>A multiplayer word game. Open source backend in Swift and Vapor.</p>
                        <div class="badge-list">
                            <a href="https://github.com/jinxd/superghost" class="chip-link">Source code</a>
                            <a href="/ghost/" class="chip-link">Open details</a>
                        </div>
                    </div>
                </article>
            </div>
        </section>

    </main>

    <script src="/js/components.js"></script>
</body>

</html>
